<Project>
  <PropertyGroup>
    <ClientlessGameDataCache>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory).dependencies\AOSharp.Clientless\1.0.16\GameData'))</ClientlessGameDataCache>
  </PropertyGroup>

  <!--
    CityBuddies uses the x86 CritterAI wrapper used by the pinned AOSharp mods
    revision. Keep public upstream binaries out of this repository: restore
    exact, hash-verified copies into the ignored dependency cache before
    assembly references are resolved.
  -->
  <Target
    Name="RestoreNavmeshDependencies"
    BeforeTargets="ResolveAssemblyReferences"
    Condition="'$(MSBuildProjectName)' == 'CityBuddies'">
    <Message
      Text="Ensuring pinned CritterAI and Grid navmesh dependencies are available..."
      Importance="high" />
    <Exec
      Command="powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;$(MSBuildThisFileDirectory)build\Restore-NavmeshDependencies.ps1&quot; -DependencyRoot &quot;$(NavmeshDependencyRoot)&quot;" />
  </Target>

  <!--
    AOSharp.Clientless 1.0.16 does not include its runtime GameData files in
    the NuGet package. Flipper needs those files to resolve the static City
    Controller dynel by name. Restore them once into an ignored repository
    cache, then copy them beside each newly built Flipper executable. The
    bootstrap command is implemented inside Flipper.exe, so the build needs no
    shell script or separately installed helper.
  -->
  <Target
    Name="RestoreClientlessGameData"
    AfterTargets="Build"
    Condition="'$(MSBuildProjectName)' == 'Flipper'">
    <Message
      Text="Ensuring AOSharp.Clientless runtime GameData is available..."
      Importance="high" />
    <Exec
      Command="&quot;$(TargetPath)&quot; restore-gamedata &quot;$(ClientlessGameDataCache)&quot; &quot;$(TargetDir)GameData&quot;" />
  </Target>
</Project>
