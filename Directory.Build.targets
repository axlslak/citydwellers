<Project>
  <!-- CoreClean reads its manifest inside the target, so remove the obsolete
       ownership entry on disk before it reads it. Keep every other entry. -->
  <Target Name="ForgetRebuffConfigurationCleanEntry" BeforeTargets="CoreClean"
          Condition="Exists('$(IntermediateOutputPath)$(CleanFile)')">
    <ReadLinesFromFile File="$(IntermediateOutputPath)$(CleanFile)">
      <Output TaskParameter="Lines" ItemName="_RebuffCleanManifest" />
    </ReadLinesFromFile>
    <ItemGroup>
      <_RebuffCleanManifest Remove="@(_RebuffCleanManifest)"
          Condition="'%(_RebuffCleanManifest.Filename)%(_RebuffCleanManifest.Extension)' == 'RebuffInfo.json'" />
      <_CleanPriorFileWrites Remove="@(_CleanPriorFileWrites)"
          Condition="'%(_CleanPriorFileWrites.Filename)%(_CleanPriorFileWrites.Extension)' == 'RebuffInfo.json'" />
    </ItemGroup>
    <WriteLinesToFile File="$(IntermediateOutputPath)$(CleanFile)"
        Lines="@(_RebuffCleanManifest)" Overwrite="true" WriteOnlyWhenDifferent="true" />
  </Target>
  <!-- Earlier builds registered RebuffInfo as Content, including in projects
       consuming CityBuffers. Protect owner edits from those old Clean manifests
       as well as incremental-clean orphan removal during the transition. -->
  <Target Name="PreserveRebuffConfigurationDuringClean"
          AfterTargets="_CleanGetCurrentAndPriorFileWrites">
    <ItemGroup>
      <_CleanPriorFileWrites Remove="@(_CleanPriorFileWrites)"
          Condition="'%(_CleanPriorFileWrites.Filename)%(_CleanPriorFileWrites.Extension)' == 'RebuffInfo.json'" />
      <_CleanCurrentFileWrites Remove="@(_CleanCurrentFileWrites)"
          Condition="'%(_CleanCurrentFileWrites.Filename)%(_CleanCurrentFileWrites.Extension)' == 'RebuffInfo.json'" />
    </ItemGroup>
  </Target>
  <!-- Run even on incremental builds: HEAD and dirty state can change without source edits. -->
  <Target Name="GenerateCityDwellersBuildIdentity" BeforeTargets="CoreCompile">
    <PropertyGroup>
      <CityDwellersBuildStamp>$(IntermediateOutputPath)CityDwellers.BuildIdentity.g.cs</CityDwellersBuildStamp>
    </PropertyGroup>
    <Exec Command="powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;$(MSBuildThisFileDirectory)build\Write-BuildIdentity.ps1&quot; -RepositoryRoot &quot;$(MSBuildThisFileDirectory).&quot; -OutputFile &quot;$(CityDwellersBuildStamp)&quot;" />
    <ItemGroup>
      <Compile Include="$(CityDwellersBuildStamp)" />
      <FileWrites Include="$(CityDwellersBuildStamp)" />
    </ItemGroup>
  </Target>
  <PropertyGroup>
    <ClientlessGameDataCache>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory).dependencies\AOSharp.Clientless\1.0.16\GameData'))</ClientlessGameDataCache>
  </PropertyGroup>

  <!--
    CityBuddies uses the x86 CritterAI wrapper used by the pinned AOSharp mods
    revision. Keep public upstream binaries out of this repository: restore
    exact, hash-verified copies into the ignored dependency cache before
    assembly references are resolved.
  -->
  <Target
    Name="RestoreNavmeshDependencies"
    BeforeTargets="ResolveAssemblyReferences"
    Condition="'$(MSBuildProjectName)' == 'CityBuddies'">
    <Message
      Text="Ensuring pinned CritterAI and Grid navmesh dependencies are available..."
      Importance="high" />
    <Exec
      Command="powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;$(MSBuildThisFileDirectory)build\Restore-NavmeshDependencies.ps1&quot; -DependencyRoot &quot;$(NavmeshDependencyRoot)&quot;" />
  </Target>

  <!--
    AOSharp.Clientless 1.0.16 does not include its runtime GameData files in
    the NuGet package. Flipper needs those files to resolve the static City
    Controller dynel by name. Restore them once into an ignored repository
    cache, then copy them into the selected portable runtime root. The
    bootstrap command is implemented inside CityDwellers.exe, so the build needs no
    shell script or separately installed helper.
  -->
  <Target
    Name="RestoreClientlessGameData"
    AfterTargets="Build"
    Condition="'$(MSBuildProjectName)' == 'CityDwellers'">
    <Message
      Text="Ensuring AOSharp.Clientless runtime GameData is available..."
      Importance="high" />
    <Exec
      Command="&quot;$(TargetPath)&quot; restore-gamedata &quot;$(ClientlessGameDataCache)&quot; &quot;$(TargetDir)GameData&quot;" />
  </Target>
  <!-- Retired probe binaries are build products, never owner state. -->
  <Target Name="RemoveRetiredLoginTry"
    BeforeTargets="PreparePortableClientlessOutput"
    Condition="'$(MSBuildProjectName)' == 'CityDwellers'">
    <Delete Files="$(TargetDir)logintry.exe;$(TargetDir)logintry.exe.config;$(TargetDir)logintry.pdb;$(TargetDir)logintry.xml" />
  </Target>
  <Target Name="PreparePortableClientlessOutput"
    AfterTargets="RestoreClientlessGameData"
    Condition="'$(MSBuildProjectName)' == 'CityDwellers'">
    <Exec Command="powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;$(MSBuildThisFileDirectory)build\Prepare-PortableClientless.ps1&quot; -RuntimeDirectory &quot;$(TargetDir).&quot; -AssetsFile &quot;$(ProjectAssetsFile)&quot;" />
  </Target>
</Project>
