<Project>
  <PropertyGroup>
    <!-- Use NuGet PackageReference for every project in this repository. -->
    <RestoreProjectStyle>PackageReference</RestoreProjectStyle>
    <!-- Let MSBuild refresh the Git stamp even when Visual Studio sees no source edits. -->
    <DisableFastUpToDateCheck>true</DisableFastUpToDateCheck>
    <NavmeshUpstreamRevision>474919d017759c39a530071a0c5b7e6eb162af7a</NavmeshUpstreamRevision>
    <NavmeshDependencyRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory).dependencies\Navmesh\$(NavmeshUpstreamRevision)'))</NavmeshDependencyRoot>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System" />
    <Reference Include="System.Core" />
    <Reference Include="System.Data" />
    <Reference Include="System.Data.DataSetExtensions" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Numerics" />
    <Reference Include="System.Xml" />
    <Reference Include="System.Xml.Linq" />
    <Reference Include="Microsoft.CSharp" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="$(MSBuildThisFileDirectory)shared\ItemFamilies.cs"><Link>ItemFamilies.cs</Link></Compile>
    <Compile Include="$(MSBuildThisFileDirectory)shared\ItemCatalog.cs"><Link>ItemCatalog.cs</Link></Compile>
    <Compile Include="$(MSBuildThisFileDirectory)shared\RepositoryUpdates.cs">
      <Link>RepositoryUpdates.cs</Link>
    </Compile>
    <Compile Include="$(MSBuildThisFileDirectory)shared\BuildIdentity.cs">
      <Link>BuildIdentity.cs</Link>
    </Compile>
    <Compile Include="$(MSBuildThisFileDirectory)shared\BufferSettings.cs" Condition="'$(MSBuildProjectName)' != 'CityDwellers'">
      <Link>BufferSettings.cs</Link>
    </Compile>
    <Compile Include="$(MSBuildThisFileDirectory)shared\IncidentJournal.cs"><Link>IncidentJournal.cs</Link></Compile>
    <Compile Include="$(MSBuildThisFileDirectory)shared\ServiceEvents.cs">
      <Link>ServiceEvents.cs</Link>
    </Compile>
    <Compile Include="$(MSBuildThisFileDirectory)shared\LocalIpc.cs">
      <Link>LocalIpc.cs</Link>
    </Compile>
    <Compile Include="$(MSBuildThisFileDirectory)shared\SettingsPaths.cs">
      <Link>SettingsPaths.cs</Link>
    </Compile>
    <Compile Include="$(MSBuildThisFileDirectory)shared\BuddyPositionSnapshot.cs">
      <Link>BuddyPositionSnapshot.cs</Link>
    </Compile>
    <Compile Include="$(MSBuildThisFileDirectory)shared\LoggingDefaults.cs">
      <Link>LoggingDefaults.cs</Link>
    </Compile>
    <Compile Include="$(MSBuildThisFileDirectory)shared\TellQueue.cs">
      <Link>TellQueue.cs</Link>
    </Compile>
    <Compile Include="$(MSBuildThisFileDirectory)shared\ManagerChannelQueue.cs">
      <Link>ManagerChannelQueue.cs</Link>
    </Compile>
  </ItemGroup>

  <!-- Host also references Scriban so its dependency closure and binding redirects
       are present when the plugin loads into client AppDomains. -->
  <ItemGroup Condition="'$(MSBuildProjectName)' == 'CityDwellers' Or '$(MSBuildProjectName)' == 'CityBuffers'">
    <PackageReference Include="Scriban" Version="[7.4.0]" />
  </ItemGroup>

  <ItemGroup Condition="'$(MSBuildProjectName)' == 'CityDwellers'">
    <!-- Build tooling only; never deployed or referenced by the host. -->
    <PackageReference Include="Mono.Cecil" Version="[0.11.6]" PrivateAssets="all" ExcludeAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AOSharp.Clientless" Version="1.0.16" />
    <!-- Owner-approved 1.0.91 trial for Mali integration. Previous baseline: 1.0.84.
         1.0.106 previously failed ChatHeader.Size; 1.0.91 is not live-verified. -->
    <PackageReference Include="AOSharpSDK" Version="[1.0.91]" />
    <PackageReference Include="HtmlAgilityPack" Version="1.11.45" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="Serilog" Version="3.1.1" />
    <PackageReference Include="Serilog.Sinks.Console" Version="5.0.1" />
    <PackageReference Include="Stateless" Version="5.11.0" />
    <!-- Keep the shared-output assemblies at the floors required by Scriban
         and its System.Text.Json dependency; older direct pins cause NU1605. -->
    <PackageReference Include="System.Buffers" Version="4.6.1" />
    <PackageReference Include="System.Diagnostics.DiagnosticSource" Version="7.0.2" />
    <PackageReference Include="System.Memory" Version="4.6.3" />
    <PackageReference Include="System.Numerics.Vectors" Version="4.6.1" />
    <PackageReference Include="System.Runtime.CompilerServices.Unsafe" Version="6.1.2" />
    <PackageReference Include="System.Text.Encoding.CodePages" Version="5.0.0" />
    <PackageReference Include="System.Threading.Channels" Version="8.0.0" />
    <PackageReference Include="System.Threading.Tasks.Extensions" Version="4.6.3" />
  </ItemGroup>
</Project>
